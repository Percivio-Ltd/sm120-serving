 # Bound registration size to avoid driver limits on large host allocations.
 MAX_HOST_REGISTER_CHUNK_BYTES = 64 * 1024**3
+# Percivio (not upstream): attempts per chunk before the region
+# stays pageable, and the pause before each retry.
+HOST_REGISTER_ATTEMPTS = 3
+HOST_REGISTER_RETRY_PAUSE_S = 2.0
+# Host-wide /proc/vmstat counters logged around each attempt: page migration,
+# compaction, NUMA balancing and swap, the activity that can cut a pin short.
+_PIN_VMSTAT_PATH = "/proc/vmstat"
+_PIN_VMSTAT_KEYS = (
+    "pgmigrate_success",
+    "pgmigrate_fail",
+    "compact_stall",
+    "compact_fail",
+    "numa_hint_faults",
+    "numa_pages_migrated",
+    "pswpin",
+    "pswpout",
+)
 
 
+def _pin_vmstat() -> dict[str, int]:
+    """The _PIN_VMSTAT_KEYS counters, or {} when /proc/vmstat is unreadable."""
+    try:
+        with open(_PIN_VMSTAT_PATH, "rb") as f:
+            lines = f.read().split(b"\n")
+    except OSError:
+        return {}
+    fields = {}
+    for line in lines:
+        parts = line.split()
+        if len(parts) == 2:
+            fields[parts[0].decode("ascii", "replace")] = parts[1]
+    return {k: int(fields[k]) for k in _PIN_VMSTAT_KEYS if k in fields}
+
+
+def _pin_vmstat_delta(before: dict[str, int], after: dict[str, int]) -> str:
+    keys = [k for k in _PIN_VMSTAT_KEYS if k in before and k in after]
+    if not keys:
+        return "vmstat unread"
+    return "vmstat " + " ".join("%s+%d" % (k, after[k] - before[k]) for k in keys)
+
